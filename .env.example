# ============================================================
# Cinevo Viral Bot - Environment Configuration
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
# ============================================================

# --- TMDB API -------------------------------------------------
# Get a free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# --- Cinevo Platform ------------------------------------------
# Base URL of the Cinevo website. The bot builds clean links
# pointing back to your platform using this base.
CINEVO_BASE_URL=https://streamflixx-seven.vercel.app

# URL path format for movies. Use {id} as a placeholder for the
# TMDB movie id. Examples:
#   /movie/{id}          -> https://streamflixx-seven.vercel.app/movie/12345
#   /watch/{id}          -> https://streamflixx-seven.vercel.app/watch/12345
#   /search?q={title}    -> https://streamflixx-seven.vercel.app/search?q=Inception
CINEVO_MOVIE_PATH=/movie/{id}

# URL path format for TV shows. Use {id} as a placeholder.
CINEVO_TV_PATH=/tv/{id}


# --- Bot Behaviour --------------------------------------------
# How often the bot runs its cycle, in minutes.
# Default: 60 (once per hour). Minimum recommended: 15.
BOT_INTERVAL_MINUTES=60

# How many trending items to fetch per cycle (1-20).
TRENDING_LIMIT=10

# Media type to fetch: "movie", "tv", or "both".
TRENDING_MEDIA_TYPE=both

# Language for TMDB data (ISO 639-1 code). Default: en.
TMDB_LANGUAGE=en

# Region for trending data (ISO 3166-1 code). Optional.
TMDB_REGION=

# --- Output ---------------------------------------------------
# Directory where generated promotional content is written.
# Relative to the project root. Default: ./output
OUTPUT_DIR=./output

# File format for generated content: "json", "md", or "both".
OUTPUT_FORMAT=both

# --- Logging --------------------------------------------------
# Log level: error | warn | info | debug
LOG_LEVEL=info

# Whether to write logs to a file (./logs/bot.log).
LOG_TO_FILE=true

# --- Advanced / Retry -----------------------------------------
# Maximum number of retry attempts for failed API calls.
MAX_RETRIES=3

# Base delay (ms) between retries. Uses exponential backoff.
RETRY_BASE_DELAY_MS=1000

# Maximum delay (ms) between retries.
RETRY_MAX_DELAY_MS=30000

# Timeout (ms) for each HTTP request to TMDB.
HTTP_TIMEOUT_MS=15000
